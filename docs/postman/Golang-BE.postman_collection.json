    {
      "name": "1. Auth",
      "description": "",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/authentication/register",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"postman-{{$timestamp}}@bench.local\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setVar(k, v) {",
                  "  if (v === undefined || v === null) return;",
                  "  pm.collectionVariables.set(k, String(v));",
                  "  try { pm.environment.set(k, String(v)); } catch (e) {}",
                  "}",
                  "pm.test('register 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const t = (pm.response.json().data || {}).tokens || {};",
                  "  setVar('accessToken', t.accessToken);",
                  "  setVar('refreshToken', t.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (buyer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/authentication/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{buyerEmail}}\",\n  \"password\": \"{{buyerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setVar(k, v) {",
                  "  if (v === undefined || v === null) return;",
                  "  pm.collectionVariables.set(k, String(v));",
                  "  try { pm.environment.set(k, String(v)); } catch (e) {}",
                  "}",
                  "pm.test('login 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json().data || {};",
                  "  const t = d.tokens || {};",
                  "  setVar('accessToken', t.accessToken);",
                  "  setVar('refreshToken', t.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (seller)",
