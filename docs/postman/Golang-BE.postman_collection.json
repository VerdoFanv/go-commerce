{
  "info": {
    "name": "Golang BE",
    "description": "REST + lab chaos for golang-be.\n\nImport Lab or Local environment and select it first.\nLogin scripts write accessToken/refreshToken/adminToken to the **active environment**.\nURLs use string form `{{baseUrl}}/path` (avoids Postman host double-encoding).\nOrder/wishlist bodies use numeric `{{productId}}` (not a JSON string).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "wsUrl",
      "value": "ws://127.0.0.1:8080"
    },
    {
      "key": "apiKey",
      "value": "dev-api-key"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": "1"
    },
    {
      "key": "wishlistId",
      "value": "1"
    },
    {
      "key": "buyerEmail",
      "value": "buyer@golang-be.dev"
    },
    {
      "key": "buyerPassword",
      "value": "user123"
    },
    {
      "key": "sellerEmail",
      "value": "seller@golang-be.dev"
    },
    {
      "key": "sellerPassword",
      "value": "seller123"
    },
    {
      "key": "adminEmail",
      "value": "admin@golang-be.dev"
    },
    {
      "key": "adminPassword",
      "value": "admin123"
    }
  ],
