    {
      "name": "1. Auth",
      "description": "",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/authentication/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "authentication",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"postman-{{$timestamp}}@bench.local\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setVar(k, v) {",
                  "  if (v === undefined || v === null) return;",
                  "  pm.collectionVariables.set(k, String(v));",
                  "  // Active environment wins variable resolution \u2014 always write tokens there.",
                  "  try { pm.environment.set(k, String(v)); } catch (e) {}",
                  "}",
                  "pm.test('register 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json().data || {};",
                  "  const tokens = d.tokens || {};",
                  "  setVar('accessToken', tokens.accessToken);",
                  "  setVar('refreshToken', tokens.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (buyer/seller)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/authentication/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "authentication",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{buyerEmail}}\",\n  \"password\": \"{{buyerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setVar(k, v) {",
                  "  if (v === undefined || v === null) return;",
                  "  pm.collectionVariables.set(k, String(v));",
                  "  // Active environment wins variable resolution \u2014 always write tokens there.",
                  "  try { pm.environment.set(k, String(v)); } catch (e) {}",
                  "}",
                  "pm.test('login 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const d = body.data || {};",
                  "  const tokens = d.tokens || d; // login: data.tokens; refresh: data is tokens",
                  "  if (!tokens || !tokens.accessToken) {",
                  "    console.warn('login OK but no accessToken in', JSON.stringify(body));",
                  "    return;",
                  "  }",
                  "  setVar('accessToken', tokens.accessToken);",
                  "  setVar('refreshToken', tokens.refreshToken);",
                  "  console.log('saved accessToken/refreshToken to environment + collection');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/authentication/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "authentication",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setVar(k, v) {",
                  "  if (v === undefined || v === null) return;",
                  "  pm.collectionVariables.set(k, String(v));",
                  "  // Active environment wins variable resolution \u2014 always write tokens there.",
                  "  try { pm.environment.set(k, String(v)); } catch (e) {}",
                  "}",
                  "pm.test('admin login 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const d = body.data || {};",
                  "  const tokens = d.tokens || d;",
                  "  if (!tokens || !tokens.accessToken) {",
                  "    console.warn('admin login OK but no accessToken');",
                  "    return;",
                  "  }",
                  "  setVar('adminToken', tokens.accessToken);",
                  "  // Keep buyer tokens untouched; admin uses adminToken.",
                  "  console.log('saved adminToken to environment + collection');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
