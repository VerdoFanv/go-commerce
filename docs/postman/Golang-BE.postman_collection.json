        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/authentication/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "authentication",
                "refresh-token"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setVar(k, v) {",
                  "  if (v === undefined || v === null) return;",
                  "  pm.collectionVariables.set(k, String(v));",
                  "  // Active environment wins variable resolution \u2014 always write tokens there.",
                  "  try { pm.environment.set(k, String(v)); } catch (e) {}",
                  "}",
                  "pm.test('refresh 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json().data || {};",
                  "  // Refresh returns AuthTokens directly under data (not data.tokens).",
                  "  const tokens = d.accessToken ? d : (d.tokens || {});",
                  "  setVar('accessToken', tokens.accessToken);",
                  "  setVar('refreshToken', tokens.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
