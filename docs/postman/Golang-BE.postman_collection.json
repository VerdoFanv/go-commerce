    {
      "name": "4. Orders",
      "description": "",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders",
            "description": "Requires Idempotency-Key. productId must be a JSON number.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"qty\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setVar(k, v) {",
                  "  if (v === undefined || v === null) return;",
                  "  pm.collectionVariables.set(k, String(v));",
                  "  try { pm.environment.set(k, String(v)); } catch (e) {}",
                  "}",
                  "if (pm.response.code === 201) setVar('orderId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders?limit=20",
            "description": ""
          }
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}",
            "description": ""
          }
        },
        {
          "name": "Pay (success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/pay",
            "description": "Lab override. Worker auto-pay is the canonical Kafka path. Response: { order, payment }.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"success\",\n  \"key\": \"pay-{{$guid}}\"\n}"
            }
          }
        },
        {
          "name": "Fulfill (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/fulfill",
            "description": "Admin only. Run while order is paid \u2014 before cancel."
          }
        },
        {
          "name": "Cancel order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/cancel",
            "description": "Negative/cleanup path \u2014 use a separate pending order if you already fulfilled."
          }
        }
      ]
    },
