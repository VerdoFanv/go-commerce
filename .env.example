APP_ENV=development
APP_PORT=8080
API_KEY=dev-api-key
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=golang_be
DB_SSLMODE=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PRODUCTS=products.events
KAFKA_TOPIC_DLQ=products.events.dlq
KAFKA_GROUP_WORKER=golang-be-worker
KAFKA_GROUP_NOTIFIER=golang-be-notifier

MONGO_URI=mongodb://admin:admin@localhost:27017/?authSource=admin
MONGO_DB=golang_be_audit

TYPESENSE_ADDR=http://localhost:8108
TYPESENSE_API_KEY=dev-typesense-key

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=10
PRODUCT_CACHE_TTL=5m

# Comma-separated. Production forbids "*".
CORS_ORIGINS=*
# Set true only when TLS is terminated in front of the API.
ENABLE_HSTS=false
# Unpaid orders auto-cancel + release stock after this TTL.
ORDER_HOLD_TTL=15m

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
METRICS_PORT=2112
